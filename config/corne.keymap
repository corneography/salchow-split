#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        copy_combo {
            bindings = <&kp LC(C)>;
            key-positions = <16 15>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        select_all_combo {
            bindings = <&kp LC(A)>;
            key-positions = <16 14>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        cut_combo {
            bindings = <&kp LC(X)>;
            key-positions = <16 3>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <28 27>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        undo_combo {
            bindings = <&kp LC(Z)>;
            key-positions = <27 26>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        redo_combo {
            bindings = <&kp LC(LS(Z))>;
            key-positions = <26 28>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        save_combo {
            bindings = <&kp LC(S)>;
            key-positions = <15 14>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <16 13>;
            layers = <0>;
            require-prior-idle-ms = <30>;
            timeout-ms = <30>;
        };

        splat_combo {
            bindings = <&kp LC(V)>;
            key-positions = <16 27>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        ctrl_backspace_combo {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        tab_left {
            bindings = <&kp LC(TAB)>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <1>;
        };

        tab_right {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <20 21>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <1>;
        };

        close_tab {
            bindings = <&kp LC(T)>;
            key-positions = <21 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <1>;
        };
    };

    macros {
        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "COPY";
        };

        select_all: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp X>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CUT";
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "UNDO";
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LCTRL &kp LEFT_SHIFT>;

            label = "REDO";
        };

        save: save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "SAVE";
        };

        splat: splat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "SPLAT";
        };

        ctrl_backspace: ctrl_delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp BACKSPACE>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRL_DELETE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
&kp ESC             &kp Q    &kp W  &kp F     &kp P            &kp B                 &kp J                 &kp L            &kp U      &kp V      &kp SEMICOLON  &kp ESC
&mt LEFT_SHIFT TAB  &lt 3 A  &kp R  &kp S     &kp T            &kp D                 &kp H                 &kp N            &kp E      &kp I      &kp O          &kp BACKSPACE
&kp LCTRL           &kp Z    &kp X  &kp C     &kp V            &kp B                 &kp K                 &kp M            &kp DOT    &kp COMMA  &kp FSLH       &kp DELETE
                                    &kp LGUI  &lt 1 BACKSPACE  &mt LEFT_ALT SPACE    &mt LEFT_SHIFT ENTER  &lt 2 BACKSPACE  &kp LCTRL
            >;
        };

        left_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |STDUL|     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "Left";
            bindings = <
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DELETE       &kp K_SCROLL_UP    &kp LC(T)  &kp UP     &kp LC(LS(T))  &trans            &trans
&trans  &mo 3   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp BACKSPACE    &kp K_SCROLL_DOWN  &kp LEFT   &kp UP     &kp RIGHT      &kp PRINTSCREEN   &trans
&trans  &kp N0  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERIOD       &kp HOME           &kp PG_UP  &kp PG_DN  &kp C_AC_BACK  &kp C_AC_FORWARD  &trans
                              &trans        &trans        &trans           &trans             &trans     &trans
            >;
        };

        right_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "Right";
            bindings = <
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F8  &kp F9            &kp F10            &kp F11        &kp F12  &trans
&trans  &trans        &kp GRAVE     &kp EQUAL     &kp MINUS     &kp F6          &kp F7  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans   &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &kp SINGLE_QUOTE  &trans             &trans         &trans   &tog 4
                                    &trans        &trans        &trans          &trans  &trans            &trans
            >;
        };

        left_arrows {
            bindings = <
&trans  &trans  &trans          &kp UP_ARROW    &trans           &trans    &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans    &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans    &kp KP_NUMBER_0  &kp KP_N1        &kp KP_N2        &kp KP_NUMBER_3  &trans  &trans
                                &trans          &trans           &trans    &trans           &trans           &trans
            >;
        };

        gamer {
            bindings = <
&trans  &kp ESC    &kp Q  &kp W   &kp E  &kp R        &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &kp LSHFT  &kp A  &kp S   &kp D  &kp F        &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &kp LCTRL  &kp Z  &kp X   &kp C  &kp V        &trans  &kp N7  &kp N8  &kp N9  &kp N0  &tog 4
                          &trans  &mo 1  &kp SPACE    &trans  &mo 2   &trans
            >;
        };
    };
};
